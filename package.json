{
  "name": "gym-tracker",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web && node scripts/generate-service-worker.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "doctor": "expo-doctor",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run doctor"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "expo": "~57.0.20",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-sharing": "~57.0.19",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/jest": "~29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "^1.20.4",
    "fake-indexeddb": "^6.2.5",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo"
  }
}
